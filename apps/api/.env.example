APP_NAME=Yao Lawyer API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

DATABASE_URL=sqlite:///./data/yao_lawyer.db
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=72
SMS_CODE_TTL_SECONDS=300
# Admin-only token for /v1/admin/* endpoints.
# Keep it isolated from normal user JWT tokens.
ADMIN_BEARER_TOKEN=replace-with-a-long-random-admin-token

AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_HIGH=gpt-6.1-sol
AI_MODEL_LOW=gpt-6-luna
AI_MODEL_ANALYSIS=gpt-6.1-sol
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=5000
# Callback header must be: X-Callback-Signature
# signature = HMAC_SHA256(
#   secret,
#   "{channel}|{order_id}|{provider_order_id}|{paid_flag}|{amount_cents_or_empty}"
# )
# paid_flag: paid=true -> 1, paid=false -> 0
PAYMENT_CALLBACK_WECHAT_SECRET=replace-with-wechat-callback-secret
PAYMENT_CALLBACK_DOUYIN_SECRET=replace-with-douyin-callback-secret
# Local-only payment parameters. This is forced off when APP_ENV=prod.
PAYMENT_MOCK_ENABLED=false

# WeChat Mini Program one-click login
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat Pay v3 production configuration
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example.com/v1/pay/wechat/notify

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=40
QUEUE_ETA_SECONDS=45
FREE_CHAT_QUOTA=10
FREE_REPORT_QUOTA=1

# Refund guardrails are code-enforced (no env switch):
# - only paid orders can be refunded
# - newer paid orders / consumed credits / consumed claimed referral rewards
#   will require manual review (HTTP 409)
